.page-shell { box-sizing: border-box; min-height: 100vh; width: 100%; padding: 24rpx 24rpx 80rpx; overflow-x: hidden; background: linear-gradient(180deg, #e1f3e9 0, #f5f7f6 360rpx); color: #18352a; }
.intro-card, .form-card { box-sizing: border-box; width: 100%; margin-bottom: 18rpx; padding: 26rpx; border: 1rpx solid rgba(30, 91, 64, .08); border-radius: 24rpx; background: rgba(255,255,255,.96); box-shadow: 0 10rpx 28rpx rgba(25,79,56,.06); }
.eyebrow, .page-title, .page-copy, .section-title, .option-title { display: block; }
.eyebrow { color: #2b815f; font-size: 19rpx; font-weight: 700; letter-spacing: 3rpx; }
.page-title { margin-top: 6rpx; font-size: 40rpx; font-weight: 800; }
.page-copy { margin-top: 8rpx; color: #71877e; font-size: 23rpx; }
.section-title { margin-bottom: 18rpx; font-size: 30rpx; font-weight: 750; }
.player-row, .field-row, .radio-row, .switch-row { display: flex; align-items: center; justify-content: space-between; min-width: 0; }
.player-row { margin-top: 12rpx; }
.seat-mark { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin-right: 14rpx; border-radius: 15rpx; background: #eaf6f0; color: #168a5b; font-weight: 800; }
.text-input { box-sizing: border-box; flex: 1; min-width: 0; height: 70rpx; padding: 0 18rpx; border-radius: 16rpx; background: #f5f7f6; }
.field-row, .switch-row, .radio-row { min-height: 76rpx; border-top: 1rpx solid #edf1ef; }
.form-card > .field-row:first-of-type, .option-stack .radio-row:first-child { border-top: 0; }
.top-divider { margin-top: 10rpx; }
.field-label { color: #38554a; }
.picker-value { color: #168a5b; font-weight: 650; }
.number-input { box-sizing: border-box; width: 150rpx; height: 58rpx; padding: 0 16rpx; border-radius: 14rpx; background: #f3f6f4; text-align: right; }
.radio-row { padding: 0 4rpx; }
.option-title { font-weight: 650; }
.switch-row switch { transform: scale(.86); transform-origin: right center; }
.submit-button { height: 92rpx; border-radius: 24rpx; background: linear-gradient(135deg, #0e8e5a, #19b474); color: #fff; font-size: 31rpx; font-weight: 750; line-height: 92rpx; box-shadow: 0 12rpx 26rpx rgba(16,139,89,.2); }
.submit-button::after { border: 0; }
