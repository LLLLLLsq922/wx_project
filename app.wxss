/**app.wxss**/
page {
    background-color: #f5f5f5;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'Segoe UI', Arial, sans-serif;
    font-size: 28rpx;
    line-height: 1.6;
    width: 100%;
    overflow-x: hidden;
  }

  .container {
    padding: 20rpx;
    min-height: 100vh;
  }
  
  /* 通用按钮样式 */
  .btn {
    padding: 20rpx 40rpx;
    border: none;
    border-radius: 10rpx;
    font-size: 28rpx;
    text-align: center;
    transition: all 0.3s;
  }
  
  .btn-primary {
    background-color: #07c160;
    color: white;
  }
  
  .btn-secondary {
    background-color: #1989fa;
    color: white;
  }
  
  .btn-warning {
    background-color: #ff6b35;
    color: white;
  }
  
  /* 通用卡片样式 */
  .card {
    background: white;
    border-radius: 10rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  }
  
  /* 通用标题样式 */
  .section-title {
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 20rpx;
    display: block;
    color: #333;
  }
  
  /* 输入框样式 */
  .input {
    width: 100%;
    padding: 20rpx;
    border: 1rpx solid #ddd;
    border-radius: 8rpx;
    font-size: 28rpx;
    background: white;
  }
  
  /* 加载状态 */
  .loading {
    text-align: center;
    padding: 40rpx;
    color: #999;
  }
  
  /* 错误状态 */
  .error {
    text-align: center;
    padding: 40rpx;
    color: #ff6b35;
  }
