.home-page {
  box-sizing: border-box;
  min-height: 100vh;
  width: 100%;
  padding: 30rpx 24rpx 180rpx;
  overflow-x: hidden;
  background: linear-gradient(180deg, #dff2e7 0, #eef5f0 360rpx, #f5f7f6 100%);
  color: #18352a;
}

.hero {
  padding: 28rpx 10rpx 34rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: #287a58;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero-title {
  display: block;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.hero-copy {
  display: block;
  margin-top: 12rpx;
  color: #557067;
  font-size: 27rpx;
}

.variant-panel,
.action-card,
.storage-warning,
.phase-note {
  box-sizing: border-box;
  border: 1rpx solid rgba(27, 83, 60, 0.08);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 30rpx rgba(32, 80, 61, 0.07);
}

.variant-panel {
  padding: 24rpx;
}

.panel-heading,
.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-title {
  font-size: 31rpx;
  font-weight: 700;
}

.panel-note {
  color: #82968f;
  font-size: 22rpx;
}

.variant-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.variant-card {
  position: relative;
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  padding: 18rpx 12rpx 16rpx;
  border: 2rpx solid #e4ebe7;
  border-radius: 18rpx;
  text-align: center;
  transition: transform 120ms ease, border-color 120ms ease, background 120ms ease;
}

.variant-card.is-selected {
  border-color: #16a36a;
  background: #eaf8f1;
}

.variant-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin: 0 auto 10rpx;
  border-radius: 17rpx;
  background: #edf2ef;
  color: #28654d;
  font-size: 28rpx;
  font-weight: 800;
}

.is-selected .variant-mark {
  background: #16a36a;
  color: #fff;
}

.variant-name,
.variant-meta {
  display: block;
  white-space: nowrap;
}

.variant-name {
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 700;
  text-overflow: ellipsis;
}

.variant-meta {
  margin-top: 3rpx;
  color: #83938d;
  font-size: 20rpx;
}

.selected-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  color: #108c5a;
  font-size: 17rpx;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 28rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #0d8d59, #18b674);
  box-shadow: 0 14rpx 28rpx rgba(15, 143, 90, 0.22);
  color: #fff;
  transition: transform 120ms ease, opacity 120ms ease;
}

.action-kicker,
.primary-title,
.primary-copy,
.action-title,
.action-copy {
  display: block;
}

.action-kicker {
  margin-bottom: 5rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 21rpx;
}

.primary-title {
  font-size: 38rpx;
  font-weight: 800;
}

.primary-copy {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 23rpx;
}

.action-arrow {
  font-size: 56rpx;
  font-weight: 300;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-card {
  min-width: 0;
  padding: 24rpx;
  transition: transform 120ms ease, opacity 120ms ease;
}

.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: #eaf5ef;
  color: #17885a;
  font-size: 24rpx;
  font-weight: 800;
}

.action-title {
  font-size: 29rpx;
  font-weight: 750;
}

.action-copy {
  margin-top: 7rpx;
  color: #758981;
  font-size: 22rpx;
  line-height: 1.45;
}

.count-badge {
  min-width: 34rpx;
  padding: 2rpx 9rpx;
  border-radius: 999rpx;
  background: #ffefe3;
  color: #d96d22;
  font-size: 20rpx;
  text-align: center;
}

.storage-warning,
.phase-note {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  color: #8b5c20;
  font-size: 22rpx;
  line-height: 1.5;
}

.storage-warning {
  border-color: #f1cfac;
  background: #fff8ed;
  color: #a54f27;
}

.press-feedback {
  opacity: 0.86;
  transform: scale(0.97);
}
