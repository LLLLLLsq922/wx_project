/* pages/rules/rules.wxss */
.rules-container {
    min-height: 100vh;
    background-color: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
    padding: 20rpx 30rpx;
    background: #fff;
    border-bottom: 1rpx solid #eee;
    position: sticky;
    top: 0;
    z-index: 10;
}

.search-input {
    position: relative;
    display: flex;
    align-items: center;
}

.search-field {
    flex: 1;
    height: 72rpx;
    padding: 0 70rpx 0 30rpx;
    background: #f5f5f5;
    border-radius: 36rpx;
    font-size: 28rpx;
}

.clear-btn {
    position: absolute;
    right: 20rpx;
    font-size: 36rpx;
    color: #999;
    width: 40rpx;
    height: 40rpx;
    text-align: center;
    line-height: 38rpx;
    background: #ddd;
    border-radius: 50%;
}

.clear-btn:active {
    background: #ccc;
}

/* 番数筛选标签 */
.fan-filter {
    white-space: nowrap;
    padding: 20rpx 30rpx;
    background: #fff;
    border-bottom: 1rpx solid #eee;
}

.fan-tag {
    display: inline-block;
    padding: 12rpx 28rpx;
    margin-right: 16rpx;
    font-size: 26rpx;
    color: #666;
    background: #f0f0f0;
    border-radius: 28rpx;
    transition: all 0.2s;
}

.fan-tag.active {
    color: #fff;
    background: #07c160;
    font-weight: bold;
}

/* 分组列表 */
.group-list {
    padding: 20rpx 24rpx;
}

.group-section {
    margin-bottom: 16rpx;
    background: #fff;
    border-radius: 14rpx;
    overflow: hidden;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.group-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28rpx 30rpx;
}

.group-title-area {
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.group-fan {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.group-count {
    font-size: 24rpx;
    color: #07c160;
    background: #e8f8f0;
    padding: 6rpx 16rpx;
    border-radius: 16rpx;
}

.group-arrow {
    font-size: 24rpx;
    color: #ccc;
    transition: transform 0.3s;
}

.group-arrow.expanded {
    transform: rotate(180deg);
}

.group-body {
    padding: 0 20rpx 20rpx;
}

/* 规则卡片 */
.rule-list {
    padding: 20rpx 24rpx;
}

.rule-item {
    background: #fff;
    border-radius: 14rpx;
    padding: 28rpx 30rpx;
    margin-bottom: 16rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
    transition: all 0.2s;
}

.rule-item:active {
    transform: scale(0.98);
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.rule-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12rpx;
}

.rule-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    flex: 1;
}

.rule-fan {
    font-size: 26rpx;
    color: #07c160;
    font-weight: bold;
    background: #e8f8f0;
    padding: 6rpx 20rpx;
    border-radius: 18rpx;
    min-width: 80rpx;
    text-align: center;
}

.rule-description {
    font-size: 28rpx;
    color: #666;
    line-height: 1.6;
}

/* 搜索信息 */
.search-info {
    padding: 20rpx 30rpx;
    font-size: 26rpx;
    color: #888;
}

/* 无结果 */
.no-result {
    text-align: center;
    font-size: 28rpx;
    color: #999;
    padding: 100rpx 0;
    background: #fff;
    border-radius: 14rpx;
    margin: 20rpx 24rpx;
}
