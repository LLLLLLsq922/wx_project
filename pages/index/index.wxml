<view class="home-page">
  <view class="hero">
    <text class="eyebrow">MAHJONG ASSISTANT</text>
    <text class="hero-title">麻将助手</text>
    <text class="hero-copy">算牌、记分与牌局历史，集中在一个小程序里。</text>
  </view>

  <view class="variant-panel">
    <view class="panel-heading">
      <text class="panel-title">选择玩法</text>
      <text class="panel-note">将记住最近一次选择</text>
    </view>
    <view class="variant-grid">
      <view
        wx:for="{{variants}}"
        wx:key="id"
        class="variant-card {{selectedVariant === item.id ? 'is-selected' : ''}}"
        hover-class="press-feedback"
        hover-start-time="0"
        hover-stay-time="80"
        bindtap="selectVariant"
        data-id="{{item.id}}"
      >
        <text class="variant-mark">{{item.id === 'guobiao' ? '国' : item.id === 'sichuan' ? '川' : '日'}}</text>
        <text class="variant-name">{{item.name}}</text>
        <text class="variant-meta">{{item.playerCount}}人 · {{item.scoreUnit}}</text>
        <text class="selected-dot" wx:if="{{selectedVariant === item.id}}">已选</text>
      </view>
    </view>
  </view>

  <view class="storage-warning" wx:if="{{storageMessage}}">
    <text>本地数据读取或保存异常：{{storageMessage}}</text>
  </view>

  <view class="primary-action" hover-class="press-feedback" bindtap="openQuickCalc">
    <view>
      <text class="action-kicker">当前玩法 · {{selectedVariantName}}</text>
      <text class="primary-title">快速算牌</text>
      <text class="primary-copy">输入完整手牌，校验和牌并计算得分</text>
    </view>
    <text class="action-arrow">›</text>
  </view>

  <view class="action-grid">
    <view class="action-card" hover-class="press-feedback" bindtap="openCreateMatch">
      <text class="action-icon">＋</text>
      <text class="action-title">创建牌局</text>
      <text class="action-copy">配置规则与四名玩家</text>
    </view>
    <view class="action-card" hover-class="press-feedback" bindtap="openActiveMatches">
      <view class="action-row">
        <text class="action-icon">续</text>
        <text class="count-badge" wx:if="{{activeMatchCount}}">{{activeMatchCount}}</text>
      </view>
      <text class="action-title">继续牌局</text>
      <text class="action-copy">恢复未结束的牌局</text>
    </view>
    <view class="action-card" hover-class="press-feedback" bindtap="openHistory">
      <view class="action-row">
        <text class="action-icon">史</text>
        <text class="count-badge" wx:if="{{historyCount}}">{{historyCount}}</text>
      </view>
      <text class="action-title">历史记录</text>
      <text class="action-copy">查看结算与得分走势</text>
    </view>
    <view class="action-card" hover-class="press-feedback" bindtap="openRules">
      <text class="action-icon">规</text>
      <text class="action-title">规则百科</text>
      <text class="action-copy">检索牌型与计分规则</text>
    </view>
  </view>

  <view class="phase-note" wx:if="{{selectedVariant !== 'guobiao'}}">
    <text wx:if="{{selectedVariant === 'sichuan'}}">成都川麻已开放创建和继续牌局；快速算牌与局内录入正在接入。</text>
    <text wx:else>四人日麻正在按阶段接入；当前版本可先浏览整体入口。</text>
  </view>
</view>
